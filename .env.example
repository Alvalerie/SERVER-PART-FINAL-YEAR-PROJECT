# =====================================================================
# AI Assisted Results Capturing -- environment template
#
# Copy to .env and fill in real values:
#     Copy-Item .env.example .env
#
# .env must be in .gitignore. This file must NOT contain real secrets.
# =====================================================================


# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# The pgvector extension must be enabled on this database:
#     CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/CHANGE_ME


# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
APP_NAME=AI Capturing API
APP_VERSION=1.0.0
DEBUG=true


# ---------------------------------------------------------------------
# Security
#
# Two different secrets on purpose: a leaked access secret must not be
# usable to forge refresh tokens.
#
# Generate each one separately:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------
SECRET_KEY=GENERATE_ME_DO_NOT_SHIP_THIS
ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_SECRET_KEY=GENERATE_ME_TOO_DIFFERENT_FROM_ABOVE
REFRESH_TOKEN_EXPIRE_DAYS=7


# ---------------------------------------------------------------------
# Handwriting sample quality
#
# Served to the mobile app via GET /config/sample-quality so the app and
# the server enforce the same numbers and cannot drift apart.
# ---------------------------------------------------------------------

# Below this, there is not enough stroke detail to be useful.
MIN_SAMPLE_WIDTH=150
MIN_SAMPLE_HEIGHT=150

# Rejects narrow strips. A 411x27 capture has a ratio of 15.2.
MAX_SAMPLE_ASPECT_RATIO=4.0

# Variance of the Laplacian. THIS IS A PLACEHOLDER.
# It is resolution- and content-dependent. Calibrate on real images
# before turning ENFORCE_BLUR_CHECK on.
MIN_SAMPLE_BLUR_SCORE=100.0
ENFORCE_BLUR_CHECK=false

# Standard deviation of grayscale values. Catches dark backgrounds and
# washed-out captures.
MIN_SAMPLE_CONTRAST=30.0

# Fraction of pixels that are ink after Otsu thresholding.
# Too low -> blank page. Too high -> mostly dark background, not writing.
MIN_SAMPLE_INK_RATIO=0.01
MAX_SAMPLE_INK_RATIO=0.50

# The server is slightly more permissive than what it advertises, so a
# borderline image the app accepted is never rejected on upload.
SERVER_QUALITY_TOLERANCE=0.9


# ---------------------------------------------------------------------
# Handwriting model
# ---------------------------------------------------------------------

# A student below this count is not treated as enrolled: they sit in the
# candidate pool but almost never rank correctly.
MIN_SAMPLES_PER_STUDENT=10

# Embeddings from different checkpoints are NOT comparable. Bump this
# when you retrain, and re-embed every stored sample.
MODEL_VERSION=siamese-resnet18-v1

# Path is relative to the project root.
MODEL_CHECKPOINT_PATH=ml/best_model.pth
